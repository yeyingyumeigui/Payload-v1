  "constraints": [
    {
      "id": "c-1",
      "formula": "σ_c ≤ σ_m / 3",
      "description": "姿态控制精度应优于测量精度的三分之一，保证测量噪声不被放大",
      "members": [
        {
          "attributeId": "a-star-acc",
          "role": "σ_m"
        },
        {
          "attributeId": "a-obc-point",
          "role": "σ_c"
        }
      ]
    },
    {
      "id": "c-2",
      "formula": "P_pv ≥ E_b × DOD / T_e",
      "description": "光照期输出功率需覆盖整星阴影期功耗（E_b 为蓄电池容量，DOD 放电深度，T_e 阴影时长）",
      "members": [
        {
          "attributeId": "a-panel-power",
          "role": "P_pv"
        },
        {
          "attributeId": "a-bat-cap",
          "role": "E_b"
        },
        {
          "attributeId": "a-bat-dod",
          "role": "DOD"
        }
      ]
    },
    {
      "id": "c-3",
      "formula": "σ_m + ω_s ≤ 0.05°",
      "description": "星敏感器测量精度与姿态稳定度共同决定的姿态确定误差上限",
      "members": [
        {
          "attributeId": "a-star-acc",
          "role": "σ_m"
        },
        {
          "attributeId": "a-obc-stab",
          "role": "ω_s"
        }
      ]
    },
    {
      "id": "c-4",
      "formula": "GSD = d_px × H_orb / f_cam",
      "description": "地面分辨率由像元尺寸、轨道高度与相机焦距共同约束，其中像元尺寸为耦合输入",
      "members": [
        {
          "attributeId": "a-cam-res",
          "role": "GSD"
        },
        {
          "attributeId": "a-ccd-pixel",
          "role": "d_px"
        }
      ]
    },
    {
      "id": "c-5",
      "formula": "EIRP = P_out + G_ant − L_feed",
      "description": "等效全向辐射功率由功放输出功率、天线增益与馈电损耗决定（dB 域加减），是天线五要素选型第一维（权重30）",
      "members": [
        {
          "attributeId": "a-comm-ant-eirp",
          "role": "EIRP"
        },
        {
          "attributeId": "a-comm-ant-gain",
          "role": "G_ant"
        },
        {
          "attributeId": "a-sspa-pout",
          "role": "P_out"
        },
        {
          "attributeId": "a-twta-pout",
          "role": "P_out"
        }
      ]
    },
    {
      "id": "c-6",
      "formula": "G/T = G_ant − 10lg(T_sys)",
      "description": "接收品质因数由接收天线增益与系统噪声温度决定；T_sys 主要由 LNA 噪声系数主导，是天线五要素第二维（权重25）",
      "members": [
        {
          "attributeId": "a-comm-ant-gt",
          "role": "G/T"
        },
        {
          "attributeId": "a-comm-ant-gain",
          "role": "G_ant"
        },
        {
          "attributeId": "a-lna-nf",
          "role": "NF_lna"
        }
      ]
    },
    {
      "id": "c-7",
      "formula": "G_pa = 10lg(N_el × η) + G_el",
      "description": "相控阵增益由阵元数、阵面效率与单元增益决定（忽略扫描损耗），用于反推满足 EIRP 所需阵元数",
      "members": [
        {
          "attributeId": "a-comm-ant-gain",
          "role": "G_ant"
        },
        {
          "attributeId": "a-pa-elements",
          "role": "N_el"
        }
      ]
    },
    {
      "id": "c-8",
      "formula": "G_refl = 10lg(η × (πD/λ)²)",
      "description": "反射面天线增益由口径、频率与口面效率决定，用于按 EIRP 反推所需口径",
      "members": [
        {
          "attributeId": "a-comm-ant-gain",
          "role": "G_ant"
        },
        {
          "attributeId": "a-comm-ant-aperture",
          "role": "D_ap"
