 "constraints": [
  {
   "id": "k-1",
   "formula": "(N_beamw*L_w/T_beam + L_tm/T_tm + L_atp/T_atp) / R_1553 <= 0.7",
   "description": "1553B 总线负载率约束：各周期消息流之和不超过总线速率的 70%",
   "members": [
    {
     "attributeId": "a-1553-rate",
     "role": "R_1553"
    },
    {
     "attributeId": "a-beam-cyc",
     "role": "T_beam"
    },
    {
     "attributeId": "a-beam-n",
     "role": "N_beamw"
    },
    {
     "attributeId": "a-tm-cyc",
     "role": "T_tm"
    },
    {
     "attributeId": "a-atp-cyc",
     "role": "T_atp"
    }
   ]
  },
  {
   "id": "k-2",
   "formula": "C_req = Σ k_i/T_i <= C_mips",
   "description": "算力预算：各控制环计算需求之和不超过主处理单元可用算力",
   "members": [
    {
     "attributeId": "a-cpu-req",
     "role": "C_req"
    },
    {
     "attributeId": "a-cpu-mips",
     "role": "C_mips"
    },
    {
     "attributeId": "a-beam-cyc",
     "role": "T_beam"
    },
    {
     "attributeId": "a-atp-cyc",
     "role": "T_atp"
    }
   ]
  },
  {
   "id": "k-3",
   "formula": "S_loc*u + P_tab + R_rec <= Cap_mem",
   "description": "存储预算：程序、权值/路由表与遥测记录之和不超过存储容量",
   "members": [
    {
     "attributeId": "a-c-soft",
     "role": "S_loc"
    },
    {
     "attributeId": "a-mem-cap",
     "role": "Cap_mem"
    }
   ]
  },
  {
   "id": "k-4",
   "formula": "P_ctrl <= P_pwr",
   "description": "功耗预算：整机功耗不超过二次电源供电能力",
   "members": [
    {
     "attributeId": "a-c-power",
     "role": "P_ctrl"
    },
    {
     "attributeId": "a-pwr-out",
     "role": "P_pwr"
    }
   ]
  },
  {
   "id": "k-5",
   "formula": "T_loop = max(T_beam, T_tm) + T_set",
   "description": "波束环闭环周期由调度周期、遥测周期与权值加载时间决定",
   "members": [
    {
     "attributeId": "a-loop-t",
     "role": "T_loop"
    },
    {
     "attributeId": "a-beam-cyc",
     "role": "T_beam"
    },
    {
     "attributeId": "a-bfn-set",
     "role": "T_set"
    }
   ]
  },
  {
   "id": "k-6",
   "formula": "T_det + T_route <= T_safe",
   "description": "重构时效：故障检测加重构时间需小于系统允许的安全中断时间",
   "members": [
    {
     "attributeId": "a-fdir-t",
     "role": "T_det"
    },
    {
     "attributeId": "a-route-t",
     "role": "T_route"
    }
   ]
  },
  {
   "id": "k-7",
   "formula": "T_dep <= T_win",
   "description": "展开时序时长需在平台允许窗口内完成",
   "members": [
    {
     "attributeId": "a-dep-t",
     "role": "T_dep"
    },
    {
     "attributeId": "a-dep-win",
     "role": "T_win"
    }
   ]
  },
