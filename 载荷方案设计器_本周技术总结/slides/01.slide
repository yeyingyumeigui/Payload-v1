<Slide style={{
  width: 1280, height: 720, padding: 0,
  background: 'linear-gradient(135deg, #0B1B33 0%, #132C52 55%, #0B1B33 100%)',
  flexDirection: 'row', overflow: 'hidden', position: 'relative',
}}>
  {/* ---- 背景星点场（绝对定位，atmosphere） ---- */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, zIndex: 0 }}>
    <svg width={1280} height={720} viewBox='0 0 1280 720'>
      <circle cx='120' cy='80' r='1.6' fill='#E8EEF7' opacity='0.5' />
      <circle cx='320' cy='150' r='1.2' fill='#E8EEF7' opacity='0.35' />
      <circle cx='90' cy='300' r='1.8' fill='#22D3EE' opacity='0.4' />
      <circle cx='250' cy='420' r='1.2' fill='#E8EEF7' opacity='0.3' />
      <circle cx='480' cy='60' r='1.4' fill='#E8EEF7' opacity='0.4' />
      <circle cx='620' cy='120' r='1.1' fill='#E8EEF7' opacity='0.3' />
      <circle cx='150' cy='620' r='1.5' fill='#E8EEF7' opacity='0.35' />
      <circle cx='420' cy='540' r='1.1' fill='#22D3EE' opacity='0.3' />
      <circle cx='560' cy='660' r='1.3' fill='#E8EEF7' opacity='0.3' />
      <circle cx='700' cy='40' r='1.2' fill='#E8EEF7' opacity='0.35' />
      <circle cx='1180' cy='90' r='1.5' fill='#E8EEF7' opacity='0.4' />
      <circle cx='1050' cy='650' r='1.2' fill='#E8EEF7' opacity='0.3' />
      {/* ---- 右侧 L1 主视觉：轨道弧 + 地球 + 卫星 + 波束锥 ---- */}
      <g>
        {/* 地球弧（右下大圆的一部分） */}
        <circle cx='1010' cy='620' r='260' fill='#132C52' stroke='#3B82F6' strokeWidth='1.5' opacity='0.9' />
        <circle cx='1010' cy='620' r='260' fill='none' stroke='#22D3EE' strokeWidth='0.8' opacity='0.35' />
        {/* 经纬线 */}
        <path d='M 750 620 A 260 90 0 0 0 1270 620' fill='none' stroke='#3B82F6' strokeWidth='0.8' opacity='0.4' />
        <path d='M 780 500 A 230 70 0 0 0 1240 500' fill='none' stroke='#3B82F6' strokeWidth='0.8' opacity='0.3' />
        <path d='M 1010 360 A 90 260 0 0 0 1010 880' fill='none' stroke='#3B82F6' strokeWidth='0.8' opacity='0.3' />
        <path d='M 1010 360 A 180 260 0 0 0 1010 880' fill='none' stroke='#3B82F6' strokeWidth='0.8' opacity='0.25' />
        {/* 轨道弧线 ×3 */}
        <ellipse cx='1010' cy='620' rx='380' ry='130' fill='none' stroke='#22D3EE' strokeWidth='1.2' opacity='0.45' transform='rotate(-18 1010 620)' />
        <ellipse cx='1010' cy='620' rx='450' ry='165' fill='none' stroke='#3B82F6' strokeWidth='1' opacity='0.3' transform='rotate(-18 1010 620)' />
        <ellipse cx='1010' cy='620' rx='310' ry='100' fill='none' stroke='#3B82F6' strokeWidth='0.8' opacity='0.25' transform='rotate(14 1010 620)' />
        {/* 卫星节点（轨道上） */}
        <g>
          <rect x='742' y='404' width='16' height='10' rx='2' fill='#E8EEF7' />
          <rect x='724' y='406' width='14' height='6' rx='1' fill='#3B82F6' />
          <rect x='762' y='406' width='14' height='6' rx='1' fill='#3B82F6' />
          <circle cx='750' cy='409' r='26' fill='none' stroke='#F59E0B' strokeWidth='1' opacity='0.5' />
          {/* 波束锥指向地球 */}
          <path d='M 750 420 L 880 560 L 830 585 Z' fill='#22D3EE' opacity='0.16' />
          <path d='M 750 420 L 880 560' fill='none' stroke='#22D3EE' strokeWidth='0.8' opacity='0.5' strokeDasharray='4 4' />
          <path d='M 750 420 L 830 585' fill='none' stroke='#22D3EE' strokeWidth='0.8' opacity='0.5' strokeDasharray='4 4' />
        </g>
        {/* 第二卫星（小） */}
        <g opacity='0.7'>
          <rect x='1148' y='470' width='11' height='7' rx='1.5' fill='#E8EEF7' />
          <rect x='1136' y='471' width='9' height='4' rx='1' fill='#3B82F6' />
          <rect x='1163' y='471' width='9' height='4' rx='1' fill='#3B82F6' />
        </g>
        {/* GEO 定点标注 */}
        <circle cx='880' cy='560' r='4' fill='#F59E0B' />
        <circle cx='880' cy='560' r='9' fill='none' stroke='#F59E0B' strokeWidth='1' opacity='0.6' />
      </g>
    </svg>
  </Box>

  {/* ---- 左侧骑线文字区（占 45%） ---- */}
  <Box style={{
    position: 'relative', zIndex: 1, width: 620, height: 720,
    flexDirection: 'column', justifyContent: 'center', gap: 26,
    padding: '0 0 0 70px',
  }}>
    {/* 顶部标签条 */}
    <Box style={{
      flexDirection: 'row', alignItems: 'center', gap: 12, width: 388,
      padding: '8px 18px', borderRadius: 20,
      background: 'rgba(59,130,246,0.12)', border: '1px solid rgba(34,211,238,0.35)',
    }}>
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#22D3EE' }} />
      <Text style={{ fontSize: 15, color: '#93A5BE', letterSpacing: 2, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>
        技术周报 · 2026.09.20 — 09.23
      </Text>
    </Box>

    {/* 主标题 64px */}
    <Text style={{
      fontSize: 64, fontWeight: 'bold', color: '#E8EEF7', lineHeight: 1.2,
      letterSpacing: 1, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif",
    }}>
      载荷方案设计器
    </Text>

    {/* 副题渐变条 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 56, height: 4, borderRadius: 2, background: 'linear-gradient(90deg, #3B82F6, #22D3EE)' }} />
      <Text style={{
        fontSize: 26, fontWeight: 600, color: '#22D3EE', letterSpacing: 3,
        fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif",
      }}>
        本周技术总结
      </Text>
    </Box>

    {/* 一句话概括 */}
    <Text style={{
      fontSize: 17, color: '#93A5BE', lineHeight: 1.7, width: 480,
      fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif",
    }}>
      纯 Python 零依赖完成 <span style={{ color: '#E8EEF7', fontWeight: 'bold' }}>v1 → v5.3 → v2</span> 三轮迭代：
      五引擎物理内核 · 闭环评级与 D 级救援 ·
      <span style={{ color: '#F59E0B', fontWeight: 'bold' }}> 245+ 项自动化验证全绿</span>
    </Text>

    {/* 落款 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 18 }}>
      <Box style={{ width: 3, height: 18, background: '#F59E0B', borderRadius: 2 }} />
      <Text style={{ fontSize: 15, color: '#5A6B84', letterSpacing: 1, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>
        文生载荷项目组 · 航天系统工程
      </Text>
    </Box>
  </Box>

  {/* ---- 右下页码 ---- */}
  <Box style={{ position: 'absolute', right: 40, bottom: 24, zIndex: 2, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 14, color: '#5A6B84', fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>01</Text>
    <Box style={{ width: 16, height: 1, background: '#5A6B84' }} />
    <Text style={{ fontSize: 14, color: '#5A6B84', fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>05</Text>
  </Box>
</Slide>
