<Slide style={{
  width: 1280, height: 720, padding: 0,
  background: 'linear-gradient(135deg, #0B1B33 0%, #132C52 55%, #0B1B33 100%)',
  flexDirection: 'column', alignItems: 'center', overflow: 'hidden', position: 'relative',
}}>
  {/* 星点场 + 底部轨道延伸弧（与封面呼应） */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, zIndex: 0 }}>
    <svg width={1280} height={720} viewBox='0 0 1280 720'>
      <circle cx='180' cy='110' r='1.5' fill='#E8EEF7' opacity='0.45' />
      <circle cx='420' cy='70' r='1.2' fill='#E8EEF7' opacity='0.35' />
      <circle cx='900' cy='100' r='1.6' fill='#22D3EE' opacity='0.4' />
      <circle cx='1120' cy='180' r='1.3' fill='#E8EEF7' opacity='0.4' />
      <circle cx='90' cy='320' r='1.2' fill='#E8EEF7' opacity='0.3' />
      <circle cx='1200' cy='380' r='1.4' fill='#E8EEF7' opacity='0.35' />
      <circle cx='300' cy='240' r='1.1' fill='#E8EEF7' opacity='0.3' />
      <circle cx='1010' cy='260' r='1.2' fill='#E8EEF7' opacity='0.3' />
      {/* 底部轨道弧 + 三里程碑节点 */}
      <path d='M -60 700 Q 640 540 1340 700' fill='none' stroke='#3B82F6' strokeWidth='1.4' opacity='0.5' />
      <path d='M -60 730 Q 640 585 1340 730' fill='none' stroke='#22D3EE' strokeWidth='0.9' opacity='0.3' />
      <circle cx='300' cy='637' r='5' fill='#3B82F6' />
      <circle cx='300' cy='637' r='10' fill='none' stroke='#3B82F6' strokeWidth='1' opacity='0.45' />
      <circle cx='640' cy='614' r='5' fill='#22D3EE' />
      <circle cx='640' cy='614' r='10' fill='none' stroke='#22D3EE' strokeWidth='1' opacity='0.45' />
      <circle cx='980' cy='637' r='5' fill='#F59E0B' />
      <circle cx='980' cy='637' r='10' fill='none' stroke='#F59E0B' strokeWidth='1' opacity='0.45' />
    </svg>
  </Box>

  {/* ============ 主体：居中金句 ============ */}
  <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 24, padding: '60px 110px 0 110px', zIndex: 1, width: 1280 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 44, height: 1, background: 'rgba(147,165,190,0.5)' }} />
      <Text style={{ fontSize: 15, color: '#22D3EE', letterSpacing: 4, fontWeight: 600, fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>
        NEXT WEEK · 技术计划
      </Text>
      <Box style={{ width: 44, height: 1, background: 'rgba(147,165,190,0.5)' }} />
    </Box>

    {/* 收束金句 40px */}
    <Text style={{
      fontSize: 40, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center', lineHeight: 1.35,
      letterSpacing: 2, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif",
    }}>
      让每一 dB 余量<br />都<span style={{ color: '#F59E0B' }}>有据可查</span>
    </Text>

    {/* 三项计划（横向里程碑，对应底部轨道三节点） */}
    <Box style={{ flexDirection: 'row', gap: 26, marginTop: 26, width: 1060 }}>
      {[
        { n: '1', t: 'GRASP / STK 配置窗口', d: '外部工具接口跨机器持久化，补齐仿真联调链路（v2 中跳过项）', c: '#3B82F6' },
        { n: '2', t: 'v2 源码推送归档', d: '源码与重建预览版 HTML 入 GitHub 仓库，版本可追溯', c: '#22D3EE' },
        { n: '3', t: '软件说明升级 v2', d: '说明文档同步 v2 口径：救援阶梯、角域环、信息流方向语义', c: '#F59E0B' },
      ].map((e, i) => (
        <Box key={i} style={{
          flex: 1, flexDirection: 'column', gap: 10, alignItems: 'center',
          padding: '20px 22px', borderRadius: 14,
          background: 'rgba(59,130,246,0.07)', border: '1px solid rgba(147,165,190,0.2)',
        }}>
          <Box style={{
            width: 34, height: 34, borderRadius: 17, alignItems: 'center', justifyContent: 'center',
            background: 'rgba(11,27,51,0.8)', border: '1.5px solid ' + e.c,
          }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: e.c, fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>{e.n}</Text>
          </Box>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E8EEF7', textAlign: 'center', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>{e.t}</Text>
          <Text style={{ fontSize: 12.5, color: '#93A5BE', textAlign: 'center', lineHeight: 1.55, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>{e.d}</Text>
        </Box>
      ))}
    </Box>

    {/* 落款 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginTop: 30 }}>
      <Box style={{ width: 3, height: 16, background: '#F59E0B', borderRadius: 2 }} />
      <Text style={{ fontSize: 14, color: '#5A6B84', letterSpacing: 1, fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif" }}>
        文生载荷项目组 · 2026.09.23
      </Text>
    </Box>
  </Box>

  {/* 页码 */}
  <Box style={{ position: 'absolute', right: 40, bottom: 24, zIndex: 2, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 14, color: '#5A6B84', fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>05</Text>
    <Box style={{ width: 16, height: 1, background: '#5A6B84' }} />
    <Text style={{ fontSize: 14, color: '#5A6B84', fontFamily: "'Space Grotesk','Consolas',sans-serif" }}>05</Text>
  </Box>
</Slide>
